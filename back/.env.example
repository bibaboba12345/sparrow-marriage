# Cloud.ru Foundation Models (OpenAI-compatible) — приоритет #1
# Ключ из ЛК Cloud.ru → Foundation Models
CLOUDRU_API_KEY=your-cloudru-api-key
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_MODEL=openai/gpt-oss-120b
# Альтернативы: openai/gpt-oss-20b, ai-sage/GigaChat3-10B-A1.8B, …

# Amvera Cloud LLM Inference (опционально)
# AMVERACLOUD_API_KEY=your-amvera-bearer-token
# AMVERACLOUD_BASE_URL=https://inference.waw0.amvera.ru/v1
# AMVERACLOUD_MODEL=llama70b

# OpenRouter / DeepSeek / OpenAI:
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=openrouter/free
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# STRUCTURE_MAX_CHARS=12000
# Max upload size for PDF/DOCX/TXT (MiB)
# MAX_UPLOAD_MB=100
# LLM retries on 502 / empty / timeout
# LLM_RETRY_ATTEMPTS=3
# LLM_RETRY_BASE_SEC=1.5
# LLM_TIMEOUT_SEC=120
# TOKENIZE_TIMEOUT_SEC=120
# TOKENIZE_MAX_TOKENS=16384
# TOKENIZE_RETRY_ATTEMPTS=3
# TOKENIZE_LLM=1
